# Shared rules for all STM32 projects in this repository.
# Keep source files, Drivers/, RTE/, *.ioc and *.uvprojx in Git.

# Keil build output
**/Objects/
**/Listings/
**/Debug/
**/Release/
**/build/
**/Build/

# CubeMX/Keil project-specific output directories
/CubeMXproject_hal/MDK-ARM/CubeMXproject_hal/
/Key_hal/MDK-ARM/Key_hal/

# Keil/ARMCC generated files
*.o
*.d
*.crf
*.axf
*.elf
*.hex
*.bin
*.map
*.lst
*.htm
*.lnp
# Do not ignore *.sct globally: custom linker scripts may be required.
# Auto-generated scatter files are covered by output directories above.
*.dep
*.iex
*.scvd
**/DebugConfig/

# Keil user interface state and backups
*.uvguix.*
*.uvgui.*
*.uvopt
*.uvoptx
*.uvgui
*.uvprojx.bak
*.uvoptx.bak
*.bak
*.tmp
*.~*

# Editor and operating-system caches
.DS_Store
Thumbs.db
Desktop.ini
**/.vscode/
**/.cache/

# Local credentials
.env
.env.*
!.env.example
